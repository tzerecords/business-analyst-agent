    <bpmndi:BPMNShape id="T_SendFactory_di" bpmnElement="T_SendFactory">
      <dc:Bounds x="799" y="107" width="100" height="82" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="start_f5_di" bpmnElement="start_f5">
      <dc:Bounds x="122" y="518" width="36" height="36" />
      <bpmndi:BPMNLabel><dc:Bounds x="96" y="559" width="88" height="52" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="end_f13_di" bpmnElement="end_f13">
      <dc:Bounds x="942" y="130" width="36" height="36" />
      <bpmndi:BPMNLabel><dc:Bounds x="920" y="171" width="81" height="52" /></bpmndi:BPMNLabel>
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="A7_di" bpmnElement="A7">
      <dc:Bounds x="315" y="615" width="250" height="62" />
    </bpmndi:BPMNShape>
