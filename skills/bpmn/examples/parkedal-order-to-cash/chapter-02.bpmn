<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ch02" name="Orders and factory order" targetNamespace="urn:parkedal:order-to-cash" exporter="chapters/tooling/layout.mjs (deterministic)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ch02">
    <bpmn:participant id="P_Park" name="Parkedal / Pamatec" processRef="Proc_ch02" />
    <bpmn:participant id="P_Cliente" name="Client" />
    <bpmn:participant id="P_Prov" name="Supplier (one or more factories)" />
    <bpmn:messageFlow id="m4" name="Client purchase order" sourceRef="P_Cliente" targetRef="T_FileSO" />
    <bpmn:messageFlow id="m5" name="Factory order" sourceRef="T_SendFactory" targetRef="P_Prov" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_ch02" name="Parkedal / Pamatec" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ch02">
      <bpmn:lane id="L_Prod" name="Sourcing / Sales">
        <bpmn:flowNodeRef>T_SendFactory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_f13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Comex" name="Foreign trade / Administration">
        <bpmn:flowNodeRef>T_FileSO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sys" name="System">
        <bpmn:flowNodeRef>ST_OC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Seg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Fabric</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Garment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start_f5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="ST_OC" name="Create one purchase order per supplier and the client order"><bpmn:incoming>bf_f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T_FileSO" name="File client purchase order"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Seg" name="Client segment?"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_Fabric" name="Generate factory order (fabric spec)"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ST_Garment" name="Generate factory order (garment sheet)"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T_SendFactory" name="Send factory order to supplier"><bpmn:incoming>f10</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>bf_f13</bpmn:outgoing></bpmn:userTask>
    <bpmn:startEvent id="start_f5" name="Quote lines selected"><bpmn:outgoing>bf_f5</bpmn:outgoing></bpmn:startEvent>
    <bpmn:endEvent id="end_f13" name="Factory order sent"><bpmn:incoming>bf_f13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f6" sourceRef="ST_OC" targetRef="T_FileSO" />
    <bpmn:sequenceFlow id="f7" sourceRef="T_FileSO" targetRef="G_Seg" />
    <bpmn:sequenceFlow id="f8" name="Fabric" sourceRef="G_Seg" targetRef="ST_Fabric" />
    <bpmn:sequenceFlow id="f9" name="Finished garment" sourceRef="G_Seg" targetRef="ST_Garment" />
    <bpmn:sequenceFlow id="f10" sourceRef="ST_Fabric" targetRef="T_SendFactory" />
    <bpmn:sequenceFlow id="f11" sourceRef="ST_Garment" targetRef="T_SendFactory" />
    <bpmn:sequenceFlow id="bf_f5" sourceRef="start_f5" targetRef="ST_OC" />
    <bpmn:sequenceFlow id="bf_f13" sourceRef="T_SendFactory" targetRef="end_f13" />
    <bpmn:textAnnotation id="A7"><bpmn:text>The client’s own order document arrives later; foreign trade files it</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="as7" sourceRef="T_FileSO" targetRef="A7" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ch02"><bpmndi:BPMNPlane id="Plane_ch02" bpmnElement="Collab_ch02">
    <bpmndi:BPMNShape id="P_Park_di" bpmnElement="P_Park" isHorizontal="true">
      <dc:Bounds x="16" y="97" width="1008" height="636" />
    </bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_Prod_di" bpmnElement="L_Prod" isHorizontal="true">
