<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ch04" name="Proforma" targetNamespace="urn:parkedal:order-to-cash" exporter="chapters/tooling/layout.mjs (deterministic)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ch04">
    <bpmn:participant id="P_Park" name="Parkedal / Pamatec" processRef="Proc_ch04" />
    <bpmn:participant id="P_Cliente" name="Client" />
    <bpmn:participant id="P_Fwd" name="Freight forwarder (client’s)" />
    <bpmn:messageFlow id="m7" name="Sales proforma" sourceRef="T_SendProf" targetRef="P_Cliente" />
    <bpmn:messageFlow id="m8" name="Proforma approval" sourceRef="P_Cliente" targetRef="T_RecApproval" />
    <bpmn:messageFlow id="m9" name="Booking request" sourceRef="T_Book" targetRef="P_Fwd" />
    <bpmn:messageFlow id="m10" name="Booking confirmation" sourceRef="P_Fwd" targetRef="T_RecBooking" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_ch04" name="Parkedal / Pamatec" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ch04">
      <bpmn:lane id="L_Comex" name="Foreign trade / Administration">
        <bpmn:flowNodeRef>T_IssueProf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SendProf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_f29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start_f46</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start_f19</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sys" name="System">
        <bpmn:flowNodeRef>ST_ImportLines</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ExtraCost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CoA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ProfPark</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ProfPam</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="T_IssueProf" name="Create sales proforma"><bpmn:incoming>bf_f19</bpmn:incoming><bpmn:outgoing>f19b</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="ST_ImportLines" name="Import order lines into the proforma"><bpmn:incoming>f19b</bpmn:incoming><bpmn:outgoing>f19c</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ST_ExtraCost" name="Add an extra‑cost line, if any"><bpmn:incoming>f19c</bpmn:incoming><bpmn:outgoing>f19d</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_CoA" name="Which company issues the proforma?"><bpmn:incoming>f19d</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing><bpmn:outgoing>f21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_ProfPark" name="Draft proforma invoice (Parkedal)"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ST_ProfPam" name="Draft proforma invoice (Pamatec)"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T_SendProf" name="Review, export and send the proforma"><bpmn:incoming>f22</bpmn:incoming><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T_RecApproval" name="Record proforma approval"><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="T_Book" name="Book shipment with forwarder"><bpmn:incoming>f26</bpmn:incoming><bpmn:incoming>bf_f46</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="T_RecBooking" name="Record booking and sailing dates"><bpmn:incoming>f28</bpmn:incoming><bpmn:outgoing>bf_f29</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="end_f29" name="Shipment booked"><bpmn:incoming>bf_f29</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="start_f46" name="Balance still to ship"><bpmn:outgoing>bf_f46</bpmn:outgoing></bpmn:startEvent>
    <bpmn:startEvent id="start_f19" name="Order handed to foreign trade"><bpmn:outgoing>bf_f19</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="f20" name="Parkedal" sourceRef="G_CoA" targetRef="ST_ProfPark" />
    <bpmn:sequenceFlow id="f21" name="Pamatec" sourceRef="G_CoA" targetRef="ST_ProfPam" />
    <bpmn:sequenceFlow id="f22" sourceRef="ST_ProfPark" targetRef="T_SendProf" />
    <bpmn:sequenceFlow id="f23" sourceRef="ST_ProfPam" targetRef="T_SendProf" />
    <bpmn:sequenceFlow id="f25" sourceRef="T_SendProf" targetRef="T_RecApproval" />
    <bpmn:sequenceFlow id="f26" sourceRef="T_RecApproval" targetRef="T_Book" />
    <bpmn:sequenceFlow id="f28" sourceRef="T_Book" targetRef="T_RecBooking" />
    <bpmn:sequenceFlow id="f19b" sourceRef="T_IssueProf" targetRef="ST_ImportLines" />
    <bpmn:sequenceFlow id="f19c" sourceRef="ST_ImportLines" targetRef="ST_ExtraCost" />
    <bpmn:sequenceFlow id="f19d" sourceRef="ST_ExtraCost" targetRef="G_CoA" />
    <bpmn:sequenceFlow id="bf_f29" sourceRef="T_RecBooking" targetRef="end_f29" />
    <bpmn:sequenceFlow id="bf_f46" sourceRef="start_f46" targetRef="T_Book" />
    <bpmn:sequenceFlow id="bf_f19" sourceRef="start_f19" targetRef="T_IssueProf" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ch04"><bpmndi:BPMNPlane id="Plane_ch04" bpmnElement="Collab_ch04">
    <bpmndi:BPMNShape id="P_Park_di" bpmnElement="P_Park" isHorizontal="true">
      <dc:Bounds x="16" y="97" width="1487" height="509" />
