<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ch05" name="Shipment and invoice" targetNamespace="urn:parkedal:order-to-cash" exporter="chapters/tooling/layout.mjs (deterministic)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ch05">
    <bpmn:participant id="P_Park" name="Parkedal / Pamatec" processRef="Proc_ch05" />
    <bpmn:participant id="P_Cliente" name="Client" />
    <bpmn:participant id="P_Prov" name="Supplier (one or more factories)" />
    <bpmn:participant id="P_Fwd" name="Freight forwarder (client’s)" />
    <bpmn:messageFlow id="m11" name="Bill of lading" sourceRef="P_Fwd" targetRef="T_RecBL" />
    <bpmn:messageFlow id="m12" name="Packing list" sourceRef="P_Prov" targetRef="T_RecPL" />
    <bpmn:messageFlow id="m13" name="Invoice draft" sourceRef="T_SendInv" targetRef="P_Cliente" />
    <bpmn:messageFlow id="m14" name="Invoice approval" sourceRef="P_Cliente" targetRef="T_RecInvAppr" />
    <bpmn:messageFlow id="m15" name="Packing list with invoice number" sourceRef="T_SendPL" targetRef="P_Cliente" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_ch05" name="Parkedal / Pamatec" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ch05">
      <bpmn:lane id="L_Comex" name="Foreign trade / Administration">
        <bpmn:flowNodeRef>G_Par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecBL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecPL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreateInv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CorrectInv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SendInv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecInvAppr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Fiscal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SendPL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Pend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start_f29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_f46</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sys" name="System">
        <bpmn:flowNodeRef>ST_InvLines</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CoB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_InvPark</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_InvPam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_MarkShipped</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:parallelGateway id="G_Par" name=""><bpmn:incoming>bf_f29</bpmn:incoming><bpmn:outgoing>f30</bpmn:outgoing><bpmn:outgoing>f31</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="T_RecBL" name="Record bill of lading"><bpmn:incoming>f30</bpmn:incoming><bpmn:outgoing>f32</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T_RecPL" name="Record packing list"><bpmn:incoming>f31</bpmn:incoming><bpmn:outgoing>f33</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T_CreateInv" name="Create the invoice for the shipment"><bpmn:incoming>f32</bpmn:incoming><bpmn:incoming>f33</bpmn:incoming><bpmn:outgoing>f34b</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="ST_InvLines" name="Generate invoice lines"><bpmn:incoming>f34b</bpmn:incoming><bpmn:outgoing>f35</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T_CorrectInv" name="Correct invoice lines against the packing list"><bpmn:incoming>f35</bpmn:incoming><bpmn:outgoing>f35b</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G_CoB" name="Which company issues the invoice?"><bpmn:incoming>f35b</bpmn:incoming><bpmn:outgoing>f36</bpmn:outgoing><bpmn:outgoing>f37</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_InvPark" name="Draft commercial invoice (Parkedal)"><bpmn:incoming>f36</bpmn:incoming><bpmn:outgoing>f38</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ST_InvPam" name="Draft commercial invoice (Pamatec)"><bpmn:incoming>f37</bpmn:incoming><bpmn:outgoing>f39</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T_SendInv" name="Send invoice draft for approval"><bpmn:incoming>f38</bpmn:incoming><bpmn:incoming>f39</bpmn:incoming><bpmn:outgoing>f41</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T_RecInvAppr" name="Record client invoice approval"><bpmn:incoming>f41</bpmn:incoming><bpmn:outgoing>f42</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="T_Fiscal" name="Issue fiscal e‑invoice"><bpmn:incoming>f42</bpmn:incoming><bpmn:outgoing>f43</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="ST_MarkShipped" name="Mark order lines shipped"><bpmn:incoming>f43</bpmn:incoming><bpmn:outgoing>f44</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="T_SendPL" name="Edit packing‑list header and send it"><bpmn:incoming>f44</bpmn:incoming><bpmn:outgoing>f45</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="G_Pend" name="Units still pending?"><bpmn:incoming>f45</bpmn:incoming><bpmn:outgoing>f47</bpmn:outgoing><bpmn:outgoing>bf_f46</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Order shipped and invoiced"><bpmn:incoming>f47</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="start_f29" name="Shipment booked"><bpmn:outgoing>bf_f29</bpmn:outgoing></bpmn:startEvent>
    <bpmn:endEvent id="end_f46" name="Balance still to ship"><bpmn:incoming>bf_f46</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f30" sourceRef="G_Par" targetRef="T_RecBL" />
    <bpmn:sequenceFlow id="f31" sourceRef="G_Par" targetRef="T_RecPL" />
    <bpmn:sequenceFlow id="f32" sourceRef="T_RecBL" targetRef="T_CreateInv" />
    <bpmn:sequenceFlow id="f33" sourceRef="T_RecPL" targetRef="T_CreateInv" />
    <bpmn:sequenceFlow id="f35" sourceRef="ST_InvLines" targetRef="T_CorrectInv" />
    <bpmn:sequenceFlow id="f35b" sourceRef="T_CorrectInv" targetRef="G_CoB" />
    <bpmn:sequenceFlow id="f36" name="Parkedal" sourceRef="G_CoB" targetRef="ST_InvPark" />
    <bpmn:sequenceFlow id="f37" name="Pamatec" sourceRef="G_CoB" targetRef="ST_InvPam" />
    <bpmn:sequenceFlow id="f38" sourceRef="ST_InvPark" targetRef="T_SendInv" />
    <bpmn:sequenceFlow id="f39" sourceRef="ST_InvPam" targetRef="T_SendInv" />
    <bpmn:sequenceFlow id="f41" sourceRef="T_SendInv" targetRef="T_RecInvAppr" />
    <bpmn:sequenceFlow id="f42" sourceRef="T_RecInvAppr" targetRef="T_Fiscal" />
    <bpmn:sequenceFlow id="f43" sourceRef="T_Fiscal" targetRef="ST_MarkShipped" />
    <bpmn:sequenceFlow id="f44" sourceRef="ST_MarkShipped" targetRef="T_SendPL" />
    <bpmn:sequenceFlow id="f45" sourceRef="T_SendPL" targetRef="G_Pend" />
    <bpmn:sequenceFlow id="f47" name="No, order complete" sourceRef="G_Pend" targetRef="E1" />
    <bpmn:sequenceFlow id="f34b" sourceRef="T_CreateInv" targetRef="ST_InvLines" />
    <bpmn:sequenceFlow id="bf_f29" sourceRef="start_f29" targetRef="G_Par" />
    <bpmn:sequenceFlow id="bf_f46" name="Yes, units pending" sourceRef="G_Pend" targetRef="end_f46" />
    <bpmn:textAnnotation id="A5"><bpmn:text>The fiscal e-invoice is issued outside this system</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A4"><bpmn:text>Full vs partial shipment is agreed with the client outside the system</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="as4" sourceRef="T_Fiscal" targetRef="A5" />
    <bpmn:association id="as5" sourceRef="G_Pend" targetRef="A4" />
  </bpmn:process>
